{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "aloha/image-divider",
  "version": "0.2.0",
  "title": "Image Divider",
  "category": "media",
  "icon": "format-image",
  "description": "Media Library image used as a full-width divider between page sections.",
  "textdomain": "alohaalpha-core",
  "attributes": {
    "imageId": {
      "type": "integer"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "imageWidth": {
      "type": "integer"
    },
    "imageHeight": {
      "type": "integer"
    },
    "imageSrcSet": {
      "type": "string",
      "default": ""
    },
    "imageSizes": {
      "type": "string",
      "default": "100vw"
    },
    "dividerHeight": {
      "type": "integer",
      "default": 50
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "reusable": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css"
}
